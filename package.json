{
  "name": "cipherkit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Portable native Web Crypto encryption and signatures",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symmetric": {
      "types": "./dist/src/symmetric.d.ts",
      "import": "./dist/src/symmetric.js"
    },
    "./asymmetric": {
      "types": "./dist/src/asymmetric.d.ts",
      "import": "./dist/src/asymmetric.js"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json && tsc -p tsconfig.test.json && tsc -p tsconfig.consumer.json",
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:runtime": "bun run build && CIPHERKIT_RUNTIME=1 bun test tests/runtime.test.ts",
    "check:package": "bun scripts/build.ts --check",
    "prepack": "bun run build && bun run typecheck && bun test && bun run check:package",
    "release:pack": "bun pm pack",
    "release:dry-run": "bun publish --dry-run --access public",
    "release": "bun publish --access public"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "jose": "6.1.3",
    "playwright": "1.65.0-alpha-2026-10-15",
    "typescript": "5.9.3"
  }
}
